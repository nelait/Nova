{
  "name": "plan-ops",
  "version": "0.1.0",
  "private": true,
  "description": "Retirement plan operations hub: onboarding/installation, maintenance and termination workflows with skill routing, guided actions, Claude-assisted drafting and recordkeeper (TRAC) integration.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.ts",
    "demo": "node --disable-warning=ExperimentalWarning scripts/demo.ts",
    "try:agent": "node --disable-warning=ExperimentalWarning scripts/try-fund-mapping-agent.ts",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "zod": "^4.6.7"
  }
}
